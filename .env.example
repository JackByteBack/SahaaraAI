# ── Neon Postgres ────────────────────────────────────────────────
# Use the POOLED connection string for serverless / server apps.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
# Role assumed after connecting (blank = none). Usually "authenticated".
DB_ROLE="authenticated"

# ── Neon Object Storage (S3-compatible) ──────────────────────────
# Generate a credential in the Neon console to fill ID + secret.
AWS_ENDPOINT_URL_S3="https://<storage-endpoint>"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET="sahaara"

# ── Neon Auth (OIDC) ─────────────────────────────────────────────
NEON_AUTH_URL=""
NEON_AUTH_JWKS_URL=""
