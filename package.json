{
  "name": "sahaara-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sahaara AI — non-diagnostic trauma & safety assessment console (Neon Postgres + Neon Object Storage + Neon Auth)",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "test": "node src/evaluator.js",
    "eval": "node src/evaluator.js",
    "eval:panel": "node src/evaluator.js --panel",
    "eval:json": "node src/evaluator.js --json",
    "eval:persist": "node src/evaluator.js --persist",
    "eval:s3": "node src/evaluator.js --upload",
    "eval:all": "node src/evaluator.js --persist --upload",
    "check": "node src/index.js",
    "s3:upload": "node src/s3.js upload",
    "s3:get": "node src/s3.js get",
    "db:info": "node src/db.js info",
    "db:tables": "node src/db.js tables",
    "db:query": "node src/db.js query",
    "db:perms": "node scripts/inspect-perms.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=20"
  }
}
